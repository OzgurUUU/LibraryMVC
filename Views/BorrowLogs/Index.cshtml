@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Ödünç Geçmişi (Arşiv)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="color: var(--accent-gold);"><i class="fa-solid fa-box-archive me-2"></i>Ödünç İşlem Geçmişi</h2>
        <p class="text-secondary mb-0">Üyeler tarafından geçmişte alınıp kütüphaneye iade edilmiş kitapların arşivi.</p>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Kayıt No</th>
                        <th>Üye Bilgisi</th>
                        <th>Kitap Adı</th>
                        <th>Alış Tarihi</th>
                        <th>İade Tarihi</th>
                        <th>Uzatma</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-secondary">#@item.BorrowId</td>
                                <td>
                                    <div class="fw-bold" style="color: #fff;">@item.UserFullName</div>
                                    <div class="small text-secondary">TC: @item.UserTC</div>
                                </td>
                                <td>
                                    <div style="color: var(--accent-gold);">@item.BookName</div>
                                    <div class="small text-secondary">ISBN: @item.BookISBN</div>
                                </td>
                                <td>@item.BorrowStartDate.ToShortDateString()</td>
                                <td><span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> @item.BorrowEndDate.ToShortDateString()</span></td>
                                <td><span class="badge bg-secondary">@item.BorrowExtension Kez</span></td>
                                <td class="text-end pe-4">
                                    <a asp-action="Delete" asp-route-id="@item.BorrowId" class="btn btn-sm btn-outline-danger" title="Arşivden Kalıcı Olarak Sil">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-secondary">
                                <i class="fa-solid fa-folder-open fa-2x mb-2 d-block"></i>
                                Arşivde henüz teslim edilmiş bir ödünç kaydı bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>