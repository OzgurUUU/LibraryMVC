@model IEnumerable<LibraryMVC.Models.Book>
@{
    ViewData["Title"] = "Kitaplar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="color: var(--accent-gold);"><i class="fa-solid fa-book me-2"></i>Kitap Yönetimi</h2>
        <p class="text-secondary mb-0">Sistemdeki tüm kitapları buradan yönetebilirsiniz.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Yeni Kitap Ekle
        </a>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">ISBN</th>
                        <th>Kitap Adı</th>
                        <th>Sayfa</th>
                        <th>Stok Adedi</th>
                        <th>Yıl</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-secondary">@item.BookISBN</td>
                                <td class="fw-bold" style="color: #fff;">@item.BookName</td>
                                <td>@item.BookNumOfPage</td>
                                <td>
                                    @if (item.BookCount > 0)
                                    {
                                        <span class="badge bg-success">@item.BookCount Adet</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Stokta Yok</span>
                                    }
                                </td>
                                <td>@item.BookPublicationYear</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.BookISBN" class="btn btn-sm btn-outline-light me-1" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.BookISBN" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-secondary">
                                <i class="fa-solid fa-book-open fa-2x mb-2 d-block"></i>
                                Sistemde henüz kayıtlı kitap bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>