@model LibraryMVC.Models.Book
@{
    ViewData["Title"] = "Kitap Sil";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="background-color: #441a1a; color: #ff8c8c; border:none;">
                <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            </div>
        }

        <div class="card border-danger mt-3" style="background-color: var(--panel-bg);">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0"><i class="fa-solid fa-trash-can me-2"></i>Kitap Silme Onayı</h5>
            </div>
            <div class="card-body p-4">
                <p class="lead text-center mb-4">Bu kitabı silmek istediğinizden emin misiniz?</p>

                <div class="p-3 mb-4 rounded" style="background-color: #12121a; border: 1px solid var(--border-color);">
                    <h4 style="color: var(--accent-gold);">@Model.BookName</h4>
                    <p class="text-secondary mb-1"><strong>ISBN:</strong> @Model.BookISBN</p>
                    <p class="text-secondary mb-1"><strong>Mevcut Stok:</strong> <span class="badge bg-info text-dark">@Model.BookCount Adet</span></p>

                    <hr style="border-color: var(--border-color);" />

                    <p class="text-secondary mb-1">
                        <strong>Yazarlar:</strong>
                        @foreach (var author in ViewBag.Authors as List<string>)
                        {
                            <span class="badge bg-secondary me-1">@author</span>
                        }
                    </p>
                    <p class="text-secondary mb-0">
                        <strong>Türler:</strong>
                        @foreach (var type in ViewBag.Types as List<string>)
                        {
                            <span class="badge bg-dark border border-secondary me-1">@type</span>
                        }
                    </p>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="BookISBN" />

                    @if (Model.BookCount > 1)
                    {
                        <div class="form-check mb-4 p-3 rounded" style="background-color: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.3);">
                            <input class="form-check-input ms-1" type="checkbox" name="deleteAll" value="true" id="deleteAllCheck">
                            <label class="form-check-label ms-2 fw-bold text-danger" for="deleteAllCheck">
                                DİKKAT: Stok adedini düşürmek yerine tüm kayıtları ve bağlantıları komple sil.
                            </label>
                            <small class="d-block text-secondary mt-1 ms-2">
                                (Eğer bu kutuyu işaretlemezseniz, sadece stok adedi 1 düşürülecektir.)
                            </small>
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-2">
                        <a asp-action="Index" class="btn btn-outline-light"><i class="fa-solid fa-xmark me-2"></i>İptal Et</a>
                        <button type="submit" class="btn btn-danger px-4"><i class="fa-solid fa-trash me-2"></i>Evet, Sil</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>