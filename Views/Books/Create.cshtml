@model LibraryMVC.Models.Book
@{
    ViewData["Title"] = "Yeni Kitap Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 mt-3 shadow-lg">
            <div class="card-header py-3">
                <h5 class="mb-0"><i class="fa-solid fa-book-medical me-2 text-primary"></i>Yeni Kitap Kaydı</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="BookISBN" class="form-label text-secondary">ISBN Numarası</label>
                            <input asp-for="BookISBN" class="form-control" required placeholder="Örn: 978..." />
                            <span asp-validation-for="BookISBN" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="BookName" class="form-label text-secondary">Kitap Adı</label>
                            <input asp-for="BookName" class="form-control" required placeholder="Kitabın tam adı..." />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="BookNumOfPage" class="form-label text-secondary">Sayfa Sayısı</label>
                            <input asp-for="BookNumOfPage" class="form-control" type="number" min="1" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BookCount" class="form-label text-secondary">Stok Adedi</label>
                            <input asp-for="BookCount" class="form-control" type="number" min="1" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BookPublicationYear" class="form-label text-secondary">Yayın Yılı</label>
                            <input asp-for="BookPublicationYear" class="form-control" type="number" required />
                        </div>

                        <div class="col-md-12">
                            <label asp-for="PublisherId" class="form-label text-secondary">Yayınevi</label>
                            <select asp-for="PublisherId" class="form-select" asp-items="ViewBag.Publishers" required>
                                <option value="">Yayınevi Seçiniz...</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-secondary">Yazar(lar) <span class="small opacity-50">(CTRL ile çoklu seçim)</span></label>
                            <select name="SelectedAuthorIds" class="form-select" asp-items="ViewBag.Authors" multiple size="5" required></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary">Tür(ler) <span class="small opacity-50">(CTRL ile çoklu seçim)</span></label>
                            <select name="SelectedTypeIds" class="form-select" asp-items="ViewBag.Types" multiple size="5" required></select>
                        </div>
                    </div>

                    <hr class="my-4" style="border-color: var(--border-color);" />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-light px-4">
                            <i class="fa-solid fa-arrow-left me-2"></i>Listeye Dön
                        </a>
                        <button type="submit" class="btn btn-primary px-5 shadow-sm">
                            <i class="fa-solid fa-floppy-disk me-2"></i>Kaydet
                            </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}