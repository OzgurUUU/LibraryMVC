@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Ödenmiş Cezalar Arşivi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="color: var(--accent-gold);"><i class="fa-solid fa-file-invoice-dollar me-2"></i>Tahsilat Geçmişi (Cezalar)</h2>
        <p class="text-secondary mb-0">Üyelerden tahsil edilen geçmiş ceza kayıtlarını buradan inceleyebilirsiniz.</p>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Makbuz / Log No</th>
                        <th>Üye Bilgisi</th>
                        <th>İlişkili Ödünç Kaydı</th>
                        <th>Tahsil Edilen Tutar</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-secondary">#@item.PenaltyId</td>
                                <td>
                                    <div class="fw-bold" style="color: #fff;">@item.UserFullName</div>
                                    <div class="small text-secondary">TC: @item.UserTC</div>
                                </td>
                                <td>
                                    <span style="color: var(--accent-gold);">Emanet ID: #@item.BorrowId</span>
                                </td>
                                <td>
                                    <span class="badge bg-success fs-6"><i class="fa-solid fa-check-double me-1"></i> ₺ @item.PenaltyAmount.ToString("0.00")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Delete" asp-route-id="@item.PenaltyId" class="btn btn-sm btn-outline-danger" title="Arşivden Kalıcı Olarak Sil">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-secondary">
                                <i class="fa-solid fa-receipt fa-2x mb-2 d-block"></i>
                                Arşivde henüz tahsil edilmiş bir ceza kaydı bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>