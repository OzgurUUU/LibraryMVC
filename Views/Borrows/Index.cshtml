@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Ödünç & İade Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="color: var(--accent-gold);"><i class="fa-solid fa-hand-holding-hand me-2"></i>Ödünç Takip Paneli</h2>
        <p class="text-secondary mb-0">Üyelerdeki kitapları, teslim tarihlerini ve iade işlemlerini buradan yönetin.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Yeni Kitap Ödünç Ver
        </a>
    </div>
</div>

@if (TempData["ExtensionError"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert" style="background-color: #3b2b1a; border-color: #cba153; color: #ffdf99;">
        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ExtensionError"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Kayıt No</th>
                        <th>Üye Bilgisi</th>
                        <th>Kitap Adı</th>
                        <th>Veriliş Tarihi</th>
                        <th>Son Teslim</th>
                        <th>Uzatma</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            bool isOverdue = item.BorrowEndDate < DateTime.Today;

                            <tr style="@(isOverdue ? "background-color: rgba(220, 53, 69, 0.1);" : "")">
                                <td class="ps-4 text-secondary">#@item.BorrowId</td>
                                <td>
                                    <div class="fw-bold" style="color: #fff;">@item.UserName @item.UserSurname</div>
                                    <div class="small text-secondary">@item.UserTC</div>
                                </td>
                                <td>
                                    <div style="color: var(--accent-gold);">@item.BookName</div>
                                    <div class="small text-secondary">ISBN: @item.BookISBN</div>
                                </td>
                                <td>@item.BorrowStartDate.ToShortDateString()</td>
                                <td>
                                    @if (isOverdue)
                                    {
                                        <span class="badge bg-danger"><i class="fa-solid fa-clock me-1"></i> Gecikti: @item.BorrowEndDate.ToShortDateString()</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@item.BorrowEndDate.ToShortDateString()</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@item.BorrowExtensions Kez</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Extend" asp-route-id="@item.BorrowId" class="btn btn-sm btn-outline-info me-1" title="Süreyi Uzat">
                                        <i class="fa-solid fa-calendar-plus"></i> Uzat
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.BorrowId" class="btn btn-sm btn-outline-success" title="İade Al">
                                        <i class="fa-solid fa-check-double"></i> İade Al
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-secondary">
                                <i class="fa-solid fa-box-open fa-2x mb-2 d-block"></i>
                                Şu anda üyelerde bulunan (ödünç verilmiş) hiçbir kitap yok.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>