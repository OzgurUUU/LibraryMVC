@model IEnumerable<LibraryMVC.Models.BookType>
@{
    ViewData["Title"] = "Kitap Türleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="color: var(--accent-gold);"><i class="fa-solid fa-layer-group me-2"></i>Tür Yönetimi</h2>
        <p class="text-secondary mb-0">Kitapları sınıflandırmak için kullanılan kategorileri yönetin.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Yeni Tür Ekle
        </a>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Tür ID</th>
                        <th>Kategori / Tür Adı</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-secondary">#@item.TypeId</td>
                                <td><span class="badge border border-secondary text-light" style="background-color: #1a1a24; font-size: 0.95rem;">@item.TypeName</span></td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.TypeId" class="btn btn-sm btn-outline-light me-1" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.TypeId" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-secondary">
                                <i class="fa-solid fa-tags fa-2x mb-2 d-block"></i>
                                Sistemde henüz kayıtlı tür bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>