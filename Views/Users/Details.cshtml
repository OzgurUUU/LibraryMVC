@model dynamic
@{
    ViewData["Title"] = "Üye Detayları";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 mt-3">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fa-solid fa-address-card me-2"></i>Üye Profil Kartı</h5>
                <span class="badge bg-primary">@Model.TypeName</span>
            </div>
            <div class="card-body p-4">

                <div class="text-center mb-4">
                    <div class="rounded-circle d-inline-flex justify-content-center align-items-center" style="width: 100px; height: 100px; background-color: rgba(203, 161, 83, 0.2);">
                        <i class="fa-solid fa-user fa-3x" style="color: var(--accent-gold);"></i>
                    </div>
                    <h3 class="mt-3 mb-0" style="color: #fff;">@Model.UserName @Model.UserSurname</h3>
                    <p class="text-secondary mt-1">@Model.UserTC</p>
                </div>

                <table class="table table-dark table-borderless">
                    <tbody>
                        <tr>
                            <td class="text-secondary" style="width: 150px;"><i class="fa-solid fa-envelope me-2"></i> E-Posta:</td>
                            <td>@(string.IsNullOrEmpty(Model.UserMail) ? "Belirtilmemiş" : Model.UserMail)</td>
                        </tr>
                        <tr>
                            <td class="text-secondary"><i class="fa-solid fa-phone me-2"></i> Telefon:</td>
                            <td>@(string.IsNullOrEmpty(Model.UserTel) ? "Belirtilmemiş" : Model.UserTel)</td>
                        </tr>
                        <tr>
                            <td class="text-secondary"><i class="fa-solid fa-id-badge me-2"></i> Sistem Rolü:</td>
                            <td style="color: var(--accent-gold);">@Model.TypeName</td>
                        </tr>
                    </tbody>
                </table>

                <hr class="my-4" style="border-color: var(--border-color);" />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-light"><i class="fa-solid fa-arrow-left me-2"></i>Listeye Dön</a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.UserTC" class="btn btn-primary"><i class="fa-solid fa-pen me-1"></i> Düzenle</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>