@model LibraryMVC.Models.User
@{
    ViewData["Title"] = "Yeni Üye Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 mt-3">
            <div class="card-header py-3">
                <h5 class="mb-0"><i class="fa-solid fa-user-plus me-2"></i>Yeni Üye Kaydı</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="UserTC" class="form-label">TC Kimlik Numarası (veya Öğrenci No)</label>
                            <input asp-for="UserTC" class="form-control" required placeholder="11 Haneli TC Kimlik..." maxlength="11" />
                            <span asp-validation-for="UserTC" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserName" class="form-label">Adı</label>
                            <input asp-for="UserName" class="form-control" required placeholder="Üyenin adı..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UserSurname" class="form-label">Soyadı</label>
                            <input asp-for="UserSurname" class="form-control" required placeholder="Üyenin soyadı..." />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserMail" class="form-label">E-Posta Adresi <span class="text-secondary small">(Opsiyonel)</span></label>
                            <input asp-for="UserMail" type="email" class="form-control" placeholder="ornek@posta.com" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UserTel" class="form-label">Telefon Numarası <span class="text-secondary small">(Opsiyonel)</span></label>
                            <input asp-for="UserTel" class="form-control" placeholder="0555..." />
                        </div>

                        <div class="col-md-12">
                            <label asp-for="TypeId" class="form-label">Üye Rolü / Tipi</label>
                            <select asp-for="TypeId" class="form-select" asp-items="ViewBag.typeId" required>
                                <option value="">Bir Rol Seçiniz...</option>
                            </select>
                        </div>
                    </div>

                    <hr class="my-4" style="border-color: var(--border-color);" />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-light"><i class="fa-solid fa-arrow-left me-2"></i>Listeye Dön</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-floppy-disk me-2"></i>Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>