@model LibraryMVC.Models.User
@{
    ViewData["Title"] = "Üye Düzenle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 mt-3">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fa-solid fa-user-pen me-2"></i>Üye Düzenle: @Model.UserName @Model.UserSurname</h5>
                <span class="badge bg-secondary">TC: @Model.UserTC</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="UserTC" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label text-secondary">TC Kimlik Numarası (Değiştirilemez)</label>
                            <input class="form-control text-secondary" value="@Model.UserTC" readonly style="background-color: #1a1a24;" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserName" class="form-label">Adı</label>
                            <input asp-for="UserName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UserSurname" class="form-label">Soyadı</label>
                            <input asp-for="UserSurname" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserMail" class="form-label">E-Posta Adresi</label>
                            <input asp-for="UserMail" type="email" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UserTel" class="form-label">Telefon Numarası</label>
                            <input asp-for="UserTel" class="form-control" />
                        </div>

                        <div class="col-md-12">
                            <label asp-for="TypeId" class="form-label">Üye Rolü / Tipi</label>
                            <select asp-for="TypeId" class="form-select" asp-items="ViewBag.typeId" required></select>
                        </div>
                    </div>

                    <hr class="my-4" style="border-color: var(--border-color);" />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-light"><i class="fa-solid fa-arrow-left me-2"></i>Listeye Dön</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-rotate me-2"></i>Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>