@using LibraryMVC.Models
@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Hata.</h1>
<h2 class="text-danger">İşleminiz gerçekleştirilirken bir hata oluştu.</h2>

@if (Model != null && Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3 class="mt-4">Geliştirici Modu</h3>
<p>
    Şu anda uygulamanızda bir hata meydana geldi. Hatanın detaylarını görmek için projenizin <strong>Development</strong> ortamında çalıştığından emin olun.
</p>