@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Rezervasyon Geçmişi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="color: var(--accent-gold);"><i class="fa-solid fa-clock-rotate-left me-2"></i>Rezervasyon Arşivi</h2>
        <p class="text-secondary mb-0">İptal edilen veya tamamlanan geçmiş rezervasyon kayıtları.</p>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Log No</th>
                        <th>İşlem Tarihi</th>
                        <th>Üye Bilgisi</th>
                        <th>İlişkili Ödünç ID</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-secondary">#@item.ReservationId</td>
                                <td><span class="badge bg-secondary">@item.ReservationDate.ToShortDateString()</span></td>
                                <td>
                                    <div class="fw-bold" style="color: #fff;">@item.UserFullName</div>
                                    <div class="small text-secondary">TC: @item.UserTC</div>
                                </td>
                                <td><span style="color: var(--accent-gold);">#@item.BorrowId Nolu Emanet</span></td>
                                <td class="text-end pe-4">
                                    <a asp-action="Delete" asp-route-id="@item.ReservationId" class="btn btn-sm btn-outline-danger" title="Arşivden Kalıcı Olarak Sil">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-secondary">
                                <i class="fa-solid fa-clock-rotate-left fa-2x mb-2 d-block"></i>
                                Arşivde geçmiş rezervasyon kaydı bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>