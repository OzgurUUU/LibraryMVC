@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Cezalar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="color: var(--accent-gold);"><i class="fa-solid fa-scale-balanced me-2"></i>Ceza Yönetimi</h2>
        <p class="text-secondary mb-0">Süresi geçmiş iadelerden doğan cezaları görüntüleyin ve ödemeleri alın.</p>
    </div>
    <div>
        <a asp-controller="Home" asp-action="DailyDuty" class="btn btn-outline-warning shadow-sm">
            <i class="fa-solid fa-rotate me-1"></i> Cezaları Güncelle
        </a>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Ceza No</th>
                        <th>Borçlu Üye</th>
                        <th>Geciken Kitap</th>
                        <th>Ceza Tutarı</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-secondary">#@item.PenaltyId</td>
                                <td>
                                    <div class="fw-bold" style="color: #fff;">@item.UserFullName</div>
                                    <div class="small text-secondary">@item.UserTC</div>
                                </td>
                                <td>
                                    <div style="color: var(--accent-gold);">@item.BookName</div>
                                    <div class="small text-secondary">Ödünç ID: #@item.BorrowId</div>
                                </td>
                                <td>
                                    <span class="badge bg-danger fs-6"><i class="fa-solid fa-turkish-lira-sign me-1"></i> @item.PenaltyAmount.ToString("0.00")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Delete" asp-route-id="@item.PenaltyId" class="btn btn-sm btn-outline-success" title="Ödeme Al / Sil">
                                        <i class="fa-solid fa-cash-register"></i> Tahsil Et
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-secondary">
                                <i class="fa-solid fa-face-smile fa-2x mb-2 d-block text-success"></i>
                                Harika! Sistemde ödenmemiş hiçbir ceza bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>