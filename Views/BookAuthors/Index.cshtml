@model IEnumerable<LibraryMVC.Models.BookAuthor>
@{
    ViewData["Title"] = "Yazarlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="color: var(--accent-gold);"><i class="fa-solid fa-feather-pointed me-2"></i>Yazar Yönetimi</h2>
        <p class="text-secondary mb-0">Sistemde kayıtlı tüm yazarları buradan yönetebilirsiniz.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Yeni Yazar Ekle
        </a>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Yazar ID</th>
                        <th>Yazar Adı Soyadı</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-secondary">#@item.AuthorId</td>
                                <td class="fw-bold" style="color: #fff;">@item.AuthorName @item.AuthorSurname</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.AuthorId" class="btn btn-sm btn-outline-light me-1" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.AuthorId" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-secondary">
                                <i class="fa-solid fa-feather fa-2x mb-2 d-block"></i>
                                Sistemde henüz kayıtlı yazar bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>